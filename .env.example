# OpsPilot AI configuration. Copy to .env (scripts/bootstrap.sh does this and generates
# random local passwords). Never commit .env. No paid API keys are used anywhere.

# --- Runtime ---
OPSPILOT_ENV=local                      # local | test | ci
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json | console

# --- PostgreSQL (container on 127.0.0.1:5433) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser   # container superuser; only used by infra scripts
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=opspilot
TEST_DB_NAME=opspilot_test
DB_USER=opspilot_app
DB_PASSWORD=change-me-app
# Least-privilege roles for the MCP server processes (scripts/db-roles.sh). Unset = fall back to DB_USER.
MCP_READ_DB_USER=opspilot_mcp_read
MCP_READ_DB_PASSWORD=change-me-mcp-read
MCP_ACTIONS_DB_USER=opspilot_mcp_actions
MCP_ACTIONS_DB_PASSWORD=change-me-mcp-actions
DB_POOL_SIZE=5

# --- Ollama (native, local only) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Investigation model: any local Ollama chat model with JSON-schema structured output (check one first with
# `uv run opspilot models --model <tag> --probe`). Preferred, tested in v0.4: qwen3.5:9b-q4_K_M (GGUF, 6.6 GB).
# Use the explicit -q4_K_M tag: on Apple Silicon the plain `qwen3.5:9b` tag resolves to an MLX build for which
# Ollama 0.40.x returns HTTP 501 "structured output is unavailable". Fallback: LLM_MODEL=qwen3:8b (5.2 GB).
# Nothing downloads models automatically: run `make models` (see README).
LLM_MODEL=qwen3.5:9b-q4_K_M
LLM_THINK=false                         # disable Qwen3 thinking traces for latency
LLM_NUM_CTX=8192                        # context window per request
LLM_NUM_PREDICT=1536                    # max output tokens per request
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=180
LLM_MAX_CONCURRENCY=1                   # one in-flight generation at a time
LLM_MAX_RETRIES=2
LLM_KEEP_ALIVE=10m
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024               # verified from the live model; migration uses this
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=60

# --- RAG ---
KNOWLEDGE_DIR=datasets/synthetic/knowledge
CHUNK_MAX_WORDS=220
CHUNK_OVERLAP_WORDS=40
RETRIEVAL_TOP_K=6
RETRIEVAL_RRF_K=60

# --- Uploaded incident evidence (v0.5) ---
# Raw copies of uploaded files are kept here (relative paths resolve against the repo root; git-ignored).
# `make uploads-purge` deletes uploaded incidents older than UPLOAD_RETENTION_DAYS (stop the API first).
UPLOAD_DIR=var/uploads
UPLOAD_RETENTION_DAYS=14

# --- Connected observability (v0.6, optional, read-only) ---
# A connector exists only when its URL is set; OpsPilot contacts no other destination, sends only GET requests to
# fixed query endpoints, follows no redirects and never returns these values to the browser. Use read-only
# credentials. Credentials are sent only over https (or to a loopback address). Local synthetic test setup:
# `make telemetry-up`, then uncomment the four demo lines below and restart the API.
# LOKI_URL=http://127.0.0.1:3310           # demo (make telemetry-up)
# LOKI_TENANT_ID=opspilot-demo             # demo; X-Scope-OrgID for multi-tenant Loki / Grafana Cloud user ID
# PROMETHEUS_URL=http://127.0.0.1:9390     # demo (make telemetry-up)
# TELEMETRY_TEMPLATES_FILE=infra/telemetry/query-templates.json   # demo: adds DB-pool templates
LOKI_URL=
LOKI_TENANT_ID=
LOKI_BEARER_TOKEN=                          # or LOKI_USERNAME + LOKI_PASSWORD (basic auth)
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_SERVICE_LABEL=service_name             # stream label whose value is the service name
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=                    # or PROMETHEUS_USERNAME + PROMETHEUS_PASSWORD
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_SERVICE_LABEL=service            # series label whose value is the service name
TELEMETRY_TEMPLATES_FILE=                   # JSON file with extra/overriding query templates (docs/integrations/CONNECTORS.md)
TELEMETRY_TIMEOUT_SECONDS=10
TELEMETRY_MAX_WINDOW_HOURS=6
TELEMETRY_MAX_LOG_LINES=2000                # per Loki query (Loki's own default cap is 5000)
TELEMETRY_MAX_SERIES=20                     # per Prometheus query
TELEMETRY_MAX_RESPONSE_BYTES=5242880

# --- Datadog (v0.9, optional, read-only) ---
# Off unless DATADOG_ENABLED=true. Requests go only to https://api.<DATADOG_SITE> (a documented Datadog site) and only
# to read endpoints: GET /api/v1/validate and POST to the logs search/aggregate, metrics timeseries and spans search
# query APIs. No write, monitor, dashboard or admin API is reachable. Keys are backend-only: never NEXT_PUBLIC_*,
# never returned to the browser, never stored in snapshots. Use an application key scoped to logs_read_data,
# timeseries_query and apm_read. See docs/integrations/DATADOG.md.
DATADOG_ENABLED=false
DATADOG_SITE=datadoghq.com                  # datadoghq.com | us3.datadoghq.com | us5.datadoghq.com | datadoghq.eu |
                                            # ap1.datadoghq.com | ap2.datadoghq.com | uk1.datadoghq.com | ddog-gov.com | us2.ddog-gov.com
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_ENV=                                # optional env tag added to every query, e.g. prod
DATADOG_LOG_INDEXES=                        # optional comma-separated log indexes (default: all)
DATADOG_MAX_SPANS=500                       # per span query (indexed spans; 50 span searches/min per org)
# Synthetic fixture only (`make datadog-fixture`); refused unless it is a loopback address. Leave empty for Datadog.
# DATADOG_LOCAL_API_URL=http://127.0.0.1:8126   # with DATADOG_API_KEY=fixture-api-key DATADOG_APP_KEY=fixture-app-key
DATADOG_LOCAL_API_URL=

# --- Agent policy ---
AGENT_MAX_TOOL_CALLS=60
AGENT_MAX_LLM_CALLS=6
AGENT_MAX_ROUNDS=2
RCA_CONFIDENCE_THRESHOLD=0.6
TOOL_TIMEOUT_SECONDS=20
MAX_CONCURRENT_INVESTIGATIONS=1
LANGGRAPH_STRICT_MSGPACK=true           # safe checkpoint deserialisation (required)

# --- MCP ---
MCP_TRANSPORT=stdio                     # stdio (child processes) | streamable-http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765

# --- API / security ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPERATOR_TOKEN=change-me-operator-token  # required for approval decisions; generated by bootstrap
ACTION_SIGNING_KEY=change-me-signing-key # HMAC key binding approvals to exact actions; generated by bootstrap
APPROVAL_TOKEN_TTL_SECONDS=900
APPROVAL_REQUEST_TTL_SECONDS=3600     # pending approvals expire after this; the run ends as approval_expired

# --- Observability ---
OTEL_EXPORTER=none                      # none | console | otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=opspilot-api

# --- Web (Next.js server side) ---
OPSPILOT_API_URL=http://127.0.0.1:8000
# Web sign-in (BFF). Required: without them every BFF request fails closed (503). Generated by bootstrap.
OPSPILOT_WEB_SESSION_SECRET=change-me-session-secret-at-least-32-chars
OPSPILOT_WEB_OPERATOR_PASSPHRASE=change-me-operator-passphrase   # operator role: decide, cancel, ingest, start
OPSPILOT_WEB_VIEWER_PASSPHRASE=                                   # optional read-only role
OPSPILOT_WEB_ORIGIN=                                              # optional; set when served on a non-default origin
