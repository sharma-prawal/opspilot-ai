# OpsPilot AI configuration. Copy to .env (scripts/bootstrap.sh does this and generates
# random local passwords). Never commit .env. No paid API keys are used anywhere.

# --- Runtime ---
OPSPILOT_ENV=local                      # local | test | ci
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json | console

# --- PostgreSQL (container on 127.0.0.1:5433) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser   # container superuser; only used by infra scripts
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=opspilot
TEST_DB_NAME=opspilot_test
DB_USER=opspilot_app
DB_PASSWORD=change-me-app
# Least-privilege roles for the MCP server processes (scripts/db-roles.sh). Unset = fall back to DB_USER.
MCP_READ_DB_USER=opspilot_mcp_read
MCP_READ_DB_PASSWORD=change-me-mcp-read
MCP_ACTIONS_DB_USER=opspilot_mcp_actions
MCP_ACTIONS_DB_PASSWORD=change-me-mcp-actions
DB_POOL_SIZE=5

# --- Ollama (native, local only) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_THINK=false                         # disable Qwen3 thinking traces for latency
LLM_NUM_CTX=8192                        # context window per request
LLM_NUM_PREDICT=1536                    # max output tokens per request
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=180
LLM_MAX_CONCURRENCY=1                   # one in-flight generation at a time
LLM_MAX_RETRIES=2
LLM_KEEP_ALIVE=10m
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024               # verified from the live model; migration uses this
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=60

# --- RAG ---
KNOWLEDGE_DIR=datasets/synthetic/knowledge
CHUNK_MAX_WORDS=220
CHUNK_OVERLAP_WORDS=40
RETRIEVAL_TOP_K=6
RETRIEVAL_RRF_K=60

# --- Agent policy ---
AGENT_MAX_TOOL_CALLS=60
AGENT_MAX_LLM_CALLS=6
AGENT_MAX_ROUNDS=2
RCA_CONFIDENCE_THRESHOLD=0.6
TOOL_TIMEOUT_SECONDS=20
MAX_CONCURRENT_INVESTIGATIONS=1
LANGGRAPH_STRICT_MSGPACK=true           # safe checkpoint deserialisation (required)

# --- MCP ---
MCP_TRANSPORT=stdio                     # stdio (child processes) | streamable-http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765

# --- API / security ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPERATOR_TOKEN=change-me-operator-token  # required for approval decisions; generated by bootstrap
ACTION_SIGNING_KEY=change-me-signing-key # HMAC key binding approvals to exact actions; generated by bootstrap
APPROVAL_TOKEN_TTL_SECONDS=900
APPROVAL_REQUEST_TTL_SECONDS=3600     # pending approvals expire after this; the run ends as approval_expired

# --- Observability ---
OTEL_EXPORTER=none                      # none | console | otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=opspilot-api

# --- Web (Next.js server side) ---
OPSPILOT_API_URL=http://127.0.0.1:8000
# Web sign-in (BFF). Required: without them every BFF request fails closed (503). Generated by bootstrap.
OPSPILOT_WEB_SESSION_SECRET=change-me-session-secret-at-least-32-chars
OPSPILOT_WEB_OPERATOR_PASSPHRASE=change-me-operator-passphrase   # operator role: decide, cancel, ingest, start
OPSPILOT_WEB_VIEWER_PASSPHRASE=                                   # optional read-only role
OPSPILOT_WEB_ORIGIN=                                              # optional; set when served on a non-default origin
